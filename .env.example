VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-key
# Use the browser-safe publishable key (or legacy anon key), never a secret/service-role key.
# The local demo is enabled automatically by Vite development when auth is unconfigured.
# Leave credentials out to browse the sample. Production editing always requires auth.
