{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "e-xhibit",
  "main": "worker/index.ts",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "r2_buckets": [
    { "binding": "MUSEUM", "bucket_name": "e-xhibit" },
    { "binding": "DISPLAY", "bucket_name": "e-xhibit-display" },
  ],
  "images": { "binding": "IMAGES" },
  "ratelimits": [
    { "name": "AUTH_LIMITER", "namespace_id": "1001", "simple": { "limit": 240, "period": 60 } },
    { "name": "CREATE_LIMITER", "namespace_id": "1002", "simple": { "limit": 120, "period": 60 } },
  ],
  "triggers": { "crons": ["17 * * * *"] },
  "vars": {
    "SUPABASE_URL": "https://YOUR_PROJECT.supabase.co",
    "APP_ORIGIN": "https://YOUR_DOMAIN",
    "R2_ACCOUNT_ID": "YOUR_ACCOUNT_ID",
    "R2_BUCKET_NAME": "e-xhibit",
    "MAX_STORAGE_BYTES": "21474836480",
    "MAX_UPLOAD_BYTES": "100000000",
    "MAX_IMAGE_PIXELS": "100000000",
  },
  "observability": { "enabled": true },
}
